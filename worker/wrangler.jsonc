{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alamatai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "keep_vars": true,
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["APP_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alamatai-gazetteer",
      "database_id": "1fa86306-3e88-4825-b4c1-4151b10d4ecb",
      "migrations_dir": "migrations"
    }
  ]
}
